# ==============================================================================
# Blueprint-X .gitignore
# ==============================================================================

# ── Python & Virtual Environments ─────────────────────────────────────────────
.venv/
venv/
venv*/
env/
ENV/
env.bak/
venv.bak/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
develop-eggs/
eggs/
parts/
var/
sdist/
.installed.cfg
*.egg

# ── Testing, Coverage & Caches ───────────────────────────────────────────────
.pytest_cache/
*.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.cache/

# ── AI, OCR & Model Weights / Checkpoints ─────────────────────────────────────
.EasyOCR/
*.pt
*.pth
*.onnx
*.tflite
*.engine
*.bin
runs/
training/runs/
wandb/

# ── Logs & Diagnostics ────────────────────────────────────────────────────────
*.log
*.log.*
test_orientations.log
unity_test.log
build_standalone.log

# ── Runtime Debug Images & Temporary Outputs ──────────────────────────────────
debug_*.png
debug_*.jpg
debug_*.jpeg
debug_*.bmp
test_*.png
test_*.jpg
test_viewer3d.png
dump_*.png
outputs/*
!outputs/.gitkeep
tmp/
temp/
scratch/

# ── Smoke Test & Temporary Export Dumps ───────────────────────────────────────
building_thick_walls.*
building_v3_roomwalls.*
test_export.json
test_export_*.json

# ── Unity Generated & Build Directories ───────────────────────────────────────
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emory[Cc]aptures/
[Rr]ecordings/
ExportedObj/
Assets/AssetStoreTools*
sysinfo.txt
crash*.dmp

# Unity autogenerated project & symbol files
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.pidb.meta
*.pdb
*.pdb.meta
*.mdb
*.mdb.meta
*.booproj
*.svd
*.opendb
*.VC.db
*.apk
*.aab
*.unitypackage

# ── IDE & Editor Temporary Files ──────────────────────────────────────────────
.vs/
.idea/
.vscode/
.fleet/
.cursor/
*.swp
*.swo
*~
*.bak

# ── OS Generated Files ────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
Icon?
.directory
